{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Propuesta IA de APU CodeAPU",
  "type": "object",
  "required": ["message", "questions", "sources", "assumptions", "confidence"],
  "properties": {
    "message": {"type": "string"},
    "questions": {"type": "array", "items": {"type": "string"}},
    "sources": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "string", "enum": ["alta", "media", "baja"]},
    "analysisRows": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["code", "description", "unit", "quantity", "unitPrice"],
        "properties": {
          "code": {"type": "string"},
          "description": {"type": "string"},
          "unit": {"type": "string"},
          "quantity": {"type": "number", "minimum": 0},
          "factor": {"type": "number", "minimum": 0},
          "unitPrice": {"type": "number", "minimum": 0},
          "isSubanalysis": {"type": "boolean"},
          "relationId": {"type": "string"},
          "prestoCode": {"type": "string"},
          "resourceType": {"type": "string", "enum": ["M", "O", "E", "S"]},
          "resourceFamilyCode": {"type": "string"},
          "familyItemSequence": {"type": "string"},
          "dependency": {"type": "string", "enum": ["EMPRESA", "KUBO", "SUBCONTRATO", "MIXTA", "COMPRA", "ARRIENDO", "PROPIO", "PROVEEDOR", "AUXILIAR"]},
          "destinationCode": {"type": "string"},
          "subdestinationCode": {"type": "string"},
          "partidaSourceCode": {"type": "string"},
          "relationCorrelative": {"type": "string"},
          "codeapuCode": {"type": "string"},
          "classificationOrigin": {"type": "string"},
          "classificationRule": {"type": "string"},
          "classificationStatus": {"type": "string", "enum": ["inferido", "confirmado"]},
          "resourceSource": {"type": "string"},
          "resourceNotes": {"type": "string"},
          "technicalBasis": {"type": "string", "enum": ["PENDIENTE", "EETT", "ALTERNATIVO", "MODIFICADO_CONSULTA", "RDI_NOTA_CAMBIO", "DECISION_ESTUDIO"]},
          "priceStatus": {"type": "string", "enum": ["PENDIENTE", "REFERENCIAL", "COTIZADO", "CONTRATO"]},
          "changeReference": {"type": "string"},
          "costTimingDecision": {"type": "string"},
          "codingVersion": {"type": "integer"}
        },
        "additionalProperties": false
      }
    },
    "enrichment": {
      "type": "object",
      "properties": {
        "executiveSummary": {"type": "string"},
        "executionDays": {"type": "string"},
        "reviewStatus": {"type": "string"},
        "studyProductivity": {"type": "string"},
        "theoreticalProductivity": {"type": "string"},
        "requiredProductivity": {"type": "string"},
        "crewComposition": {"type": "string"},
        "directPlacement": {"type": "string"},
        "scheduleDemand": {"type": "string"},
        "productivityBasis": {"type": "string"},
        "equipmentUsage": {"type": "string"},
        "rentalBasis": {"type": "string"},
        "technicalSources": {"type": "string"},
        "eettRequirements": {"type": "string"},
        "eettConsidered": {"type": "string"},
        "eettDecisions": {"type": "string"},
        "eettPending": {"type": "string"},
        "decisionOwner": {"type": "string"},
        "decisionDate": {"type": "string"},
        "executorDecision": {"type": "string"},
        "summary": {"type": "string"},
        "technicalText": {"type": "string"},
        "measurement": {"type": "string"},
        "execution": {"type": "string"},
        "quality": {"type": "string"},
        "assumptions": {"type": "string"},
        "source": {"type": "string"},
        "bimClass": {"type": "string"},
        "bimParameters": {"type": "string"},
        "environmentalNote": {"type": "string"},
        "aiProductivityAdjustment": {"type": "string"},
        "aiCostAdjustment": {"type": "string"},
        "aiAnalysis": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

